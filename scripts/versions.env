# Versões fixadas. Alterou aqui -> rode o setup de novo.
# Valores em UMA linha (o parser do PowerShell não lê multi-linha).

MC_VERSION=1.21.11
JAVA_MAJOR=25

# Paper: "latest" resolve o último build STABLE via Fill API v3.
PAPER_BUILD=latest

# Plugins do Modrinth (baixados automaticamente). Slugs separados por espaço.
MODRINTH_PLUGINS="viaversion viabackwards viarewind luckperms worldedit duels-optimised placeholderapi tab-was-taken"

# Download manual (o setup só imprime). Pares nome|url separados por espaço.
MANUAL_PLUGINS="OldCombatMechanics|https://github.com/kernitus/BukkitOldCombatMechanics/releases/latest GrimAC|https://github.com/GrimAnticheat/Grim/releases/latest MLGRush|https://www.spigotmc.org/resources/mlg-rush-the-1vs1-bedwars.100142/"
